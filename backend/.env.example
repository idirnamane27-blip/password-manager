# Copier vers backend/.env puis renseigner PGPASSWORD localement.
# backend/.env est chargé automatiquement et ignoré par Git.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sesame
PGUSER=sesame_app
PGPASSWORD=
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Activer uniquement derrière HTTPS :
COOKIE_SECURE=false
